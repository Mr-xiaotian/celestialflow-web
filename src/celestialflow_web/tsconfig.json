{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": "static/ts",
    "outDir": "static/js"
  },
  "include": ["static/ts/**/*.ts", "static/ts/**/*.d.ts"]
}
